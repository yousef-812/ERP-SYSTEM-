{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=app.db"
  },
  "BackgroundWorker": {
    "IntervalHours": 4
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET"
  }
}
